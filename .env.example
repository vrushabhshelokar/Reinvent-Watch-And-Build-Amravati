# Public canonical site URL for production metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://reinvent-amravati.vercel.app

# Optional: Public analytics measurement ID if using a supported provider
NEXT_PUBLIC_ANALYTICS_ID=

# Optional: Public analytics endpoint
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Production Visitor Counter Persistent Storage (Vercel KV or Upstash Redis REST API)
# In development, local file-based storage (.data/visitor-stats.json) is used automatically when these are unset.
# For Vercel production: connect Vercel KV or an Upstash Redis database in Vercel project settings.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatively, direct Upstash Redis:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
