# Public canonical site URL for production metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://reinvent-amravati.vercel.app

# Optional: Public analytics measurement ID if using a supported provider
NEXT_PUBLIC_ANALYTICS_ID=

# Optional: Public analytics endpoint
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Production Visitor Counter Persistent Storage (Upstash Redis via Vercel Marketplace)
# Add Upstash Redis from Vercel Marketplace or Upstash Console:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatively, Vercel KV environment variables are also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
